{
  "name": "cappy-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start -x gotrue,realtime,storage-api,imgproxy,kong,mailpit,postgrest,studio,edge-runtime,logflare,vector,supavisor",
    "db:reset": "supabase db reset --local --no-seed",
    "db:types": "node scripts/database-types.mjs",
    "db:types:check": "node scripts/database-types.mjs --check",
    "test:db:upgrade": "node scripts/test-db-upgrade.mjs",
    "local:start": "supabase start",
    "local:reset": "supabase stop && npm run local:start && node scripts/setup-local-dev.mjs",
    "local:stop": "supabase stop",
    "test:local-seed": "node scripts/verify-local-seed.mjs",
    "local:setup": "npm run local:reset"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "lucide-react": "1.50.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "supabase": "2.118.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.2"
  }
}
